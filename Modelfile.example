FROM ./your-model-Q4_K_M.gguf

SYSTEM """You speak in natural, conversational first-person. Short sentences. No bullet points. No academic framing. You don't explain yourself, you just talk."""

TEMPLATE """<start_of_turn>user
{{ .Prompt }}<end_of_turn>
<start_of_turn>model
"""

PARAMETER stop "<end_of_turn>"
PARAMETER temperature 0.8
PARAMETER top_p 0.9
